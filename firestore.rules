rules_version = '2';

// 서적부 POS 보안 규칙
// - 로그인한 '가게 공용 계정'만 데이터를 읽고 쓸 수 있습니다.
// - 그 외 아무나 URL을 알아도 재고/매출에 접근할 수 없습니다.
// - STORE_EMAIL 자리에 실제 가게 계정 이메일을 넣어 배포하세요.

service cloud.firestore {
  match /databases/{database}/documents {

    function isStore() {
      return request.auth != null
        && request.auth.token.email == 'pcl206@naver.com';
    }

    // 책(재고)
    match /books/{bookId} {
      allow read, write: if isStore();
    }

    // 매출/반품 내역
    match /transactions/{txId} {
      allow read, write: if isStore();
    }

    // 재고·가격 변동 원장 (입고/판매/반품/조정/등록/삭제 기록)
    // 한 번 남긴 기록은 고쳐 쓸 수 없게 update를 막습니다.
    // (delete는 '전체 초기화'와 '백업 복원'에 필요해서 열어둡니다)
    match /stockLogs/{logId} {
      allow read, create, delete: if isStore();
      allow update: if false;
    }

    // 초기 세팅 플래그
    match /meta/{docId} {
      allow read, write: if isStore();
    }

    // 그 외 경로는 전부 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
